# Optional: Isaacus API key — needed only by the enrichment stage (womblex[isaacus]).
# Get yours at https://platform.isaacus.com/
ISAACUS_API_KEY=

# Optional: override the local models/ directory used by utils/models.py.
# WOMBLEX_MODELS_DIR=/path/to/models

# --- Cloud / distributed execution (womblex[cloud]) --------------------------
# Only needed for `womblex enqueue` / `worker` / `jobs`. Local runs ignore these.

# Postgres DSN backing the job queue. Also read from DATABASE_URL.
# WOMBLEX_DB_DSN=postgresql://womblex:womblex@localhost:5432/womblex

# Object-store base URI shared by enqueue + workers (inputs and shard outputs).
# s3:// (incl. MinIO), gs://, az://, or a local path for testing.
# WOMBLEX_STORE_URI=s3://womblex

# S3-compatible endpoint (e.g. MinIO). Omit for real AWS S3. Also AWS_ENDPOINT_URL.
# WOMBLEX_S3_ENDPOINT=http://localhost:9000

# Object-store credentials (standard AWS env vars; s3fs reads these).
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
