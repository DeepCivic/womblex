# Womblex console sidecar image (`womblex ui`, docs/ui-plan.md).
#
# Separate from the pipeline `Dockerfile` rather than a build-arg variant of
# it, because the two images diverge once the SPA lands: this one gains a
# Node build stage that the worker image has no reason to carry, and it
# installs a different extras set.
#
# The builder stage compiles `ui/` to static JS/CSS/HTML; only those files
# cross into the final stage, so no Node runtime ships in the image
# (docs/ui-plan.md, the "Frontend" section). `womblex.ui.app.create_app` mounts
# `ui/build` if it finds it there and serves the read API alone otherwise —
# same image shape as before merge 4, just with the frontend now present.

# uv exports the lock at build time; it is mounted, never installed. A stage
# of its own so the pin is a FROM line that dependency updates can read.
FROM ghcr.io/astral-sh/uv:0.13.4 AS uv

FROM node:22-slim AS frontend-builder
WORKDIR /app/ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ .
RUN npm run build

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Supplements the wheel-bundled womblex/_models/ root, never replaces it
    # (utils.models searches every root per artefact).
    WOMBLEX_MODELS_DIR=/app/models

# The console imports `store/` readers, which reach `ingest.extract` for
# `ExtractionResult` and so import numpy at module load; no PDF library loads
# until a document is opened. Verified by import trace: numpy and semchunk
# load; torch, sentence-transformers and cv2 do not. libglib/libGL are kept
# from when PyMuPDF needed them.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# `[ui]` is fastapi + uvicorn only. The object-storage reads a distributed run
# needs (docs/ui-plan.md section 2 — remote reads are in scope from the first merge)
# ride on fsspec + s3fs, which are now *core* dependencies, so a bare
# `womblex[ui]` console reads an `s3://` store out of the box — no `[cloud]`
# required. boto3 is core too, but the console never imports it (it reads
# artefacts, makes no AWS call). This was the cloud-deployment break: the image
# used to depend on `[cloud]` carrying s3fs, so any build that dropped the
# extra 500'd on `s3://` with "Install s3fs to access S3".
ARG EXTRAS=ui
# Dependencies install from `uv.lock`, hash-checked, as in `Dockerfile`: the
# image ships the set CI tested, and this layer stays cached until the lock
# changes. uv is mounted for the export, not installed.
COPY pyproject.toml uv.lock /app/
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    extras="" \
    && for e in $(echo "${EXTRAS}" | tr ',' ' '); do extras="${extras} --extra ${e}"; done \
    && uv export --frozen --no-dev ${extras} --no-emit-project -o /tmp/requirements.txt \
    && pip install --require-hashes -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY . /app
COPY --from=frontend-builder /app/ui/build /app/ui/build
RUN pip install --no-deps .

# The source commit, supplied rather than discovered: `.dockerignore` excludes
# `.git`, and a build context is a copy of a work tree rather than one, so a
# build that tried to read it would be reading nothing. Stamped into the
# *installed* package, which is the copy `store/build_info.py` asks — and
# after the install above, so the expensive dependency layer stays cached
# across commits while only this cheap layer changes per build.
ARG SOURCE_COMMIT=""
# Whether an unstamped build is a defect. The publish path sets it; a local
# a local build does not (those live in `docker-compose.local.override.yml`),
# and its image reports `unavailable` with a reason. A published image is a claim about what it holds, so one that cannot
# name its commit is a build failure rather than an honest answer.
ARG REQUIRE_STAMP=0
RUN if [ -n "${SOURCE_COMMIT}" ]; then \
        stamp="$(python -c 'import importlib.util, pathlib; print(pathlib.Path(importlib.util.find_spec("womblex").origin).parent / "_build_stamp.py")')" \
        && printf 'COMMIT = "%s"\n' "${SOURCE_COMMIT}" > "${stamp}"; \
    elif [ "${REQUIRE_STAMP}" = "1" ]; then \
        echo "SOURCE_COMMIT is required when REQUIRE_STAMP=1" >&2 && exit 1; \
    fi

# The same fact as image metadata, readable with `docker inspect` without
# running the image. Standard OCI keys, so any registry or scanner reads them.
LABEL org.opencontainers.image.title="womblex-console" \
      org.opencontainers.image.source="https://github.com/DeepCivic/womblex" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}"

# Bind beyond loopback: the CLI defaults to 127.0.0.1, which inside a
# container would refuse every request from the published port. The console
# has no auth by design (docs/ui-plan.md), so a deployment that exposes
# this port is choosing to, and puts its own control in front.
EXPOSE 8080
ENTRYPOINT ["womblex", "ui", "--host", "0.0.0.0", "--port", "8080"]
