# Womblex console sidecar image (`womblex ui`, docs/ui-plan.md).
#
# Two stages: compile the SvelteKit SPA to static assets, then bundle them
# alongside the read-only FastAPI console into the same Python base the
# other services use, so the sidecar joins docker-compose.yml as a fourth
# service shape rather than a bespoke one.
#
# The ui-build stage needs `ui/` (docs/ui-plan.md merge 4 — the SvelteKit
# workspace). Until that merge lands, this build fails at the first COPY
# below; that is expected and does not affect CI, which builds no images.
FROM node:22-alpine AS ui-build
WORKDIR /ui
COPY ui/package.json ui/package-lock.json* ./
RUN npm ci
COPY ui/ ./
RUN npm run build

FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    WOMBLEX_MODELS_DIR=/app/models

# OpenCV (headless) + PyMuPDF need libglib/libGL at import time — the console
# pulls the same core dependency stack as the worker (pyproject.toml has no
# UI-only slim variant), so it needs the same system libraries.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

# [ui] is fastapi + uvicorn only; [cloud] adds the object-storage reads a
# store-backed run needs (docs/ui-plan.md §2 — remote reads are in scope
# from the first merge, not deferred behind a flag). Neither pulls boto3.
ARG EXTRAS=ui,cloud
RUN pip install ".[${EXTRAS}]"

# No-op until docs/ui-plan.md merge 4 lands `ui/` above and a later merge
# wires FastAPI to serve it — the assets just sit here, ready, in the
# meantime.
COPY --from=ui-build /ui/build /app/ui/build

ENTRYPOINT ["womblex"]
CMD ["--help"]
