# Written by .github/workflows/publish-images.yml when a release is cut.
# Edit the workflow, not this file — a release overwrites it.
#
# Each reference is a digest rather than a tag. A tag can be moved to
# point at different bytes; a digest is those bytes. Dependencies
# resolve at image build time and the base tag moves, so the commit
# does not determine the image — this is what identifies the artefact.
#
#   docker compose --env-file deploy/images.env up
WOMBLEX_IMAGE_RELEASE=v0.6.1
WOMBLEX_IMAGE_COMMIT=f3340e0e23b5ea9b8fd7c2ee56e12f931ff99851
WOMBLEX_PIPELINE_IMAGE=ghcr.io/deepcivic/womblex@sha256:46a6fcf7b4b5e6e1c49e8dc7fac8b6c493e7c7bb3b2be444140dfe80bec1631b
